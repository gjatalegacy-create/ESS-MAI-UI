{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nura Lingua — ui_ess_mai",
  "version": "0.1.0",
  "identifier": "com.gjatalegacy.essmai.uilingua",
  "build": { "frontendDist": "dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Nura Legacy — ESS-MAI", "width": 1480, "height": 920,
        "minWidth": 1100, "minHeight": 700, "resizable": true, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
